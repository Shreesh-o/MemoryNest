# MemoryNest configuration
# Copy to .env and fill in values. Never commit .env.

# --- Ollama (local LLM) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Storage paths (relative to project root or absolute) ---
DB_PATH=data/memorynest.db
CHROMA_DIR=data/chroma
UPLOAD_DIR=data/uploads
AUDIO_DIR=data/audio

# --- RAG ---
RAG_TOP_K=5
# Minimum cosine similarity for a retrieved chunk to be considered relevant.
# Below this, the answer is refused without calling the LLM.
RAG_MIN_SIMILARITY=0.30
CHUNK_SIZE=450
CHUNK_OVERLAP=50

# --- Email reminders (Gmail: use an app password, not your normal password) ---
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=you@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
# Where reminder emails are sent
RECIPIENT_EMAIL=you@gmail.com
