# MemoryNest configuration file.
# Copy to .env and fill in real values. Committed to git is OK (no secrets).

# --- Ollama (local LLM) ---
OLLAMA_HOST=http://localhost:11434         # Ollama server address
OLLAMA_MODEL=qwen2.5:3b-instruct          # Model name in Ollama

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2          # Sentence-transformers model
HF_HUB_OFFLINE=1                          # Force offline mode (model must be cached)

# --- Storage paths (relative to project root or absolute) ---
DB_PATH=data/memorynest.db                  # SQLite database path
CHROMA_DIR=data/chroma                      # Vector store directory
UPLOAD_DIR=data/uploads                     # User uploads directory
AUDIO_DIR=data/audio                        # TTS generated audio

# --- RAG settings ---
RAG_TOP_K=5                               # Number of retrieved chunks
RAG_MIN_SIMILARITY=0.30                   # Minimum similarity score
CHUNK_SIZE=450                            # Size of text chunks in chars
CHUNK_OVERLAP=50                          # Chunk overlap in chars

# --- Document Map (related documents) ---
LINK_MIN_SIMILARITY=0.45                  # Minimum cosine similarity for document links (read-time filter)
LINK_STORE_MIN_SIMILARITY=0.30            # Minimum cosine similarity for storing links (low floor)
LINK_MAX_PER_DOC=3                        # Max related documents per document

# --- Upload ---
MAX_FILE_SIZE_MB=20                       # Max upload size in MB

# --- Email reminders ---
EMAIL_HOST=smtp.gmail.com                   # SMTP server host
EMAIL_PORT=587                            # SMTP server port
EMAIL_USERNAME=you@gmail.com                # Gmail address (app password needed)
EMAIL_APP_PASSWORD=your-16-char-app-password # 16-char Gmail app password
RECIPIENT_EMAIL=you@gmail.com               # Where reminder emails are sent

# --- TTS ---
TTS_ENGINE=auto                           # Engine order: piper, edge, espeak, pyttsx3
TTS_VOICE=en_US-lessac-medium             # Default voice model name

# --- Auth / JWT (FastAPI) ---
JWT_SECRET=change-me-to-a-long-random-string  # Secret key for JWT signing; empty = random per restart
JWT_EXPIRE_MINUTES=720                    # JWT token expiration in minutes (default 12 hours)
CORS_ORIGINS=http://localhost:3000        # Comma-separated allowed origins for CORS
COOKIE_SECURE=false                       # Set to true in production (requires HTTPS)

# --- Google OAuth & Calendar ---
GOOGLE_CLIENT_ID=                         # Google OAuth client ID (leave empty if not using Google)
GOOGLE_CLIENT_SECRET=                     # Google OAuth client secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback # OAuth callback URI
FRONTEND_URL=http://localhost:3000        # Frontend URL for OAuth redirects
TOKEN_ENCRYPTION_KEY=                     # Fernet key or passphrase for token encryption; empty = derived from JWT_SECRET

# --- Misc ---
HF_HUB_OFFLINE=1                          # Force offline Hugging Face mode
